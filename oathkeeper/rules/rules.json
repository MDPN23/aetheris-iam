        "handler": "jwt"
      }
    ],
    "authorizer": {
      "handler": "remote_json",
      "config": {
        "remote": "http://opa:8181/v1/data/aetheris/authz",
        "payload": "{\"input\":{\"token\":\"{{ .Extra.token }}\",\"token_claims\":{\"sub\":\"{{ .Subject }}\",\"roles\":{{ .Extra.roles | toJson }},\"exp\":{{ .Extra.exp }}},\"service\":\"microservice-b\",\"method\":\"{{ .Request.Method }}\"}}"
      }
    },
    "mutators": [
